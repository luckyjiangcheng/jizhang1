/* pages/analysis/analysis.wxss */
.container {
  padding: 24rpx;
  padding-bottom: 200rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

/* 时间选择器 */
.time-selector {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.time-option {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #64748b;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.time-option.active {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  font-weight: 500;
}

/* 汇总卡片 */
.summary-card {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.summary-title {
  font-size: 32rpx;
  font-weight: 600;
}

.summary-period {
  font-size: 24rpx;
  opacity: 0.8;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
}

.summary-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 36rpx;
  font-weight: 700;
}

.summary-value.expense {
  color: #fca5a5;
}

.summary-value.income {
  color: #86efac;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

/* 分类列表 */
.category-list {
  
}

.category-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.category-item:last-child {
  border-bottom: none;
}

.category-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.category-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.category-info {
  display: flex;
  flex-direction: column;
}

.category-name {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 500;
}

.category-count {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.category-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  width: 200rpx;
}

.category-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.category-bar {
  width: 100%;
  height: 8rpx;
  background: #f1f5f9;
  border-radius: 4rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s;
}

/* 图表容器 */
.chart-container {
  width: 100%;
  height: 400rpx;
}

/* 交易列表 */
.transaction-list {
  margin-top: 16rpx;
}

.transaction-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.transaction-item:last-child {
  border-bottom: none;
}

.transaction-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.transaction-info {
  flex: 1;
}

.transaction-name {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 500;
}

.transaction-date {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.transaction-amount {
  font-size: 28rpx;
  font-weight: 600;
}

.card-more {
  font-size: 24rpx;
  color: #6366f1;
}

/* 体验版提示 */
.trial-banner {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 180rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.trial-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.trial-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.trial-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #92400e;
}

.trial-desc {
  font-size: 22rpx;
  color: #b45309;
  margin-top: 4rpx;
}

.trial-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 12rpx;
}


