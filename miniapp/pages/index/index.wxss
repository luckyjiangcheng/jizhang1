/* 首页样式 */
.container {
  padding: 32rpx;
  padding-bottom: 200rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4ff 0%, #f5f7fa 100%);
}

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  margin-bottom: 32rpx;
}

.status-left {
  display: flex;
  flex-direction: column;
}

.status-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e293b;
}

.status-subtitle {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.status-right {
  display: flex;
  align-items: center;
}

.login-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}

/* 快捷操作区 */
.quick-actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.quick-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.quick-action:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.action-text {
  font-size: 26rpx;
  color: #1e293b;
  font-weight: 500;
}

/* 统计卡片 */
.stats-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.stats-period {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #f1f5f9;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #64748b;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
}

.stat-value.income {
  color: #10b981;
}

.stat-value.expense {
  color: #ef4444;
}

/* 分类列表 */
.category-list {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.category-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.category-more {
  font-size: 24rpx;
  color: #6366f1;
}

.category-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.category-item:last-child {
  border-bottom: none;
}

.category-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.category-info {
  flex: 1;
}

.category-name {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 500;
}

.category-count {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.category-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

/* 最近交易 */
.recent-transactions {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.transaction-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.transaction-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.transaction-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.transaction-item:last-child {
  border-bottom: none;
}

.transaction-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.transaction-info {
  flex: 1;
}

.transaction-name {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 500;
}

.transaction-date {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.transaction-amount {
  font-size: 28rpx;
  font-weight: 600;
}

.transaction-amount.expense {
  color: #ef4444;
}

.transaction-amount.income {
  color: #10b981;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #64748b;
}

/* 体验版提示 */
.trial-banner {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 180rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.trial-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.trial-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.trial-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #92400e;
}

.trial-desc {
  font-size: 22rpx;
  color: #b45309;
  margin-top: 4rpx;
}

.trial-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 12rpx;
}


