/* pages/login/login.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  display: flex;
  flex-direction: column;
  padding: 0 48rpx;
}

/* 登录头部 */
.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  margin-bottom: 64rpx;
}

.login-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: #64748b;
}

/* 登录表单 */
.login-form {
  flex: 1;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1e293b;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 96rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 30rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #6366f1;
  box-shadow: 0 0 0 4rpx rgba(99, 102, 241, 0.1);
}

.code-input-wrapper {
  display: flex;
  gap: 16rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  width: 240rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 16rpx;
  border: none;
  padding: 0;
}

.code-btn.disabled {
  background: #e2e8f0;
  color: #94a3b8;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  margin-top: 48rpx;
}

.login-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 登录提示 */
.login-tips {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 32rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #64748b;
}

.tip-link {
  font-size: 26rpx;
  color: #6366f1;
  font-weight: 500;
  margin-left: 8rpx;
}

/* 底部协议 */
.login-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 48rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: #94a3b8;
}

.footer-link {
  font-size: 24rpx;
  color: #6366f1;
}
