/* pages/guide/guide.wxss */
.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 200rpx;
}

/* 指南头部 */
.guide-header {
  position: relative;
  height: 300rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #ffffff;
}

.guide-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.guide-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.guide-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 区块 */
.section {
  padding: 32rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.section-desc {
  font-size: 24rpx;
  color: #64748b;
}

/* 指南卡片 */
.guide-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
  margin-right: 20rpx;
}

.step-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 8rpx;
  display: block;
}

.step-desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.step-icon {
  font-size: 40rpx;
  flex-shrink: 0;
  margin-top: -4rpx;
}

.step-divider {
  height: 1rpx;
  background: #f1f5f9;
  margin: 20rpx 0;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  justify-content: center;
}

.install-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.3);
  transition: all 0.2s;
}

.install-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-size: 28rpx;
}

/* 常见问题 */
.faq-list {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.faq-item {
  border-bottom: 1rpx solid #f1f5f9;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  cursor: pointer;
  transition: background-color 0.2s;
}

.faq-header:active {
  background-color: #f8fafc;
}

.faq-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.faq-question {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #1e293b;
}

.faq-arrow {
  font-size: 24rpx;
  color: #64748b;
  transition: transform 0.3s;
}

.faq-answer {
  padding: 0 32rpx 24rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
  background-color: #f8fafc;
}

/* 联系客服 */
.contact-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.contact-info {
  flex: 1;
}

.contact-label {
  font-size: 22rpx;
  color: #64748b;
  display: block;
  margin-bottom: 4rpx;
}

.contact-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #1e293b;
}

.contact-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 12rpx;
  border: none;
  flex-shrink: 0;
}

/* 底部提示 */
.bottom-tip {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #64748b;
  display: flex;
  align-items: center;
}

.tip-text::before {
  content: "";
  margin-right: 8rpx;
}

/* 体验版提示 */
.trial-banner {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 180rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.trial-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.trial-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.trial-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #92400e;
}

.trial-desc {
  font-size: 22rpx;
  color: #b45309;
  margin-top: 4rpx;
}

.trial-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 12rpx;
}


