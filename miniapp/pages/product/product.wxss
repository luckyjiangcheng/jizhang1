/* pages/product/product.wxss */
.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 200rpx;
}

/* 产品头部 */
.product-header {
  position: relative;
  height: 400rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #ffffff;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.header-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 24rpx;
  opacity: 0.7;
}

/* 区块 */
.section {
  padding: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 24rpx;
}

/* 版本卡片 */
.version-cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.version-card {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.version-card.featured {
  border: 2rpx solid #6366f1;
}

.featured-badge {
  position: absolute;
  top: -12rpx;
  right: 24rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.version-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.version-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.version-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.version-features {
  margin-bottom: 24rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.feature-icon {
  color: #10b981;
  font-size: 28rpx;
  margin-right: 12rpx;
}

.feature-text {
  font-size: 26rpx;
  color: #475569;
}

.version-price {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
}

.price-label {
  font-size: 22rpx;
  color: #64748b;
  display: block;
  margin-bottom: 4rpx;
}

.price-value {
  font-size: 24rpx;
  color: #1e293b;
  font-weight: 500;
}

/* 申请卡片 */
.apply-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.apply-step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.apply-step:last-child {
  margin-bottom: 0;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
}

.step-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1e293b;
  display: block;
  margin-bottom: 4rpx;
}

.step-desc {
  font-size: 24rpx;
  color: #64748b;
}

/* 联系卡片 */
.contact-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.contact-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.contact-info {
  flex: 1;
}

.contact-label {
  font-size: 22rpx;
  color: #64748b;
  display: block;
  margin-bottom: 4rpx;
}

.contact-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #1e293b;
}

.contact-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 12rpx;
}

/* 授权码卡片 */
.auth-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.auth-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.auth-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.auth-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.auth-desc {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 20rpx;
  display: block;
}

.auth-benefits {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
}

.benefit-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.benefit-text {
  font-size: 26rpx;
  color: #475569;
}

.auth-note {
  display: flex;
  align-items: flex-start;
  background: #fef3c7;
  border-radius: 12rpx;
  padding: 16rpx;
}

.note-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.note-text {
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.5;
}

/* 体验版提示 */
.trial-banner {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 180rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.trial-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.trial-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.trial-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #92400e;
}

.trial-desc {
  font-size: 22rpx;
  color: #b45309;
  margin-top: 4rpx;
}

.trial-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 12rpx;
}




