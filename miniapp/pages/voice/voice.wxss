/* pages/voice/voice.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4ff 0%, #f5f7fa 100%);
  padding: 32rpx;
  padding-bottom: 300rpx;
}

/* 页面头部 */
.page-header {
  text-align: center;
  margin-bottom: 64rpx;
  padding: 32rpx 0;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 16rpx;
  display: block;
}

.page-subtitle {
  font-size: 24rpx;
  color: #64748b;
}

/* 识别结果 */
.result-section {
  margin-bottom: 32rpx;
}

.result-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.result-header {
  margin-bottom: 16rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.result-content {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx;
}

.result-text {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.5;
}

/* 记账信息 */
.info-section {
  margin-bottom: 32rpx;
}

.info-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.info-header {
  margin-bottom: 24rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.info-form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.form-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #475569;
}

.form-input {
  padding: 20rpx 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #1e293b;
  background: #f8fafc;
}

.form-picker {
  padding: 20rpx 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #f8fafc;
}

.picker-text {
  font-size: 26rpx;
  color: #1e293b;
}

/* 操作按钮 */
.action-section {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  transition: all 0.2s;
}

.confirm-btn {
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  color: #ffffff;
}

.cancel-btn {
  background: #f1f5f9;
  color: #64748b;
}

.action-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 录音提示 */
.recording-section {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1000;
}

.recording-card {
  background: rgba(0, 0, 0, 0.8);
  border-radius: 24rpx;
  padding: 48rpx;
  color: #ffffff;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.recording-animation {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.recording-circle {
  width: 120rpx;
  height: 120rpx;
  border: 8rpx solid #ef4444;
  border-top: 8rpx solid transparent;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.recording-text {
  font-size: 28rpx;
  font-weight: 500;
}

.recording-tip {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 语音记账按钮 */
.voice-button-section {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 30rpx;
  display: flex;
  justify-content: center;
  z-index: 999;
}

.voice-button {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(99, 102, 241, 0.4);
  transition: all 0.2s;
  border: 8rpx solid #ffffff;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.7);
  }
  70% {
    box-shadow: 0 0 0 20rpx rgba(99, 102, 241, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(99, 102, 241, 0);
  }
}

.voice-button:active {
  transform: scale(0.95);
  opacity: 0.9;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.3);
  animation: none;
}

.voice-icon {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.voice-text {
  font-size: 24rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 响应式设计 */
@media (max-width: 375px) {
  .voice-button {
    width: 140rpx;
    height: 140rpx;
  }
  
  .voice-icon {
    font-size: 56rpx;
  }
  
  .voice-text {
    font-size: 22rpx;
  }
}

@media (min-width: 414px) {
  .voice-button {
    width: 180rpx;
    height: 180rpx;
  }
  
  .voice-icon {
    font-size: 72rpx;
  }
  
  .voice-text {
    font-size: 26rpx;
  }
}