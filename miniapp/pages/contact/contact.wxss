/* pages/contact/contact.wxss */
.container {
  padding: 32rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4ff 0%, #f5f7fa 100%);
}

/* 页面头部 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  padding: 24rpx 0;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
}

/* 客服信息 */
.contact-section {
  margin-bottom: 32rpx;
}

.contact-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.contact-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.contact-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.contact-title {
  flex: 1;
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle-text {
  font-size: 24rpx;
  color: #64748b;
}

.contact-content {
  margin-bottom: 32rpx;
}

.content-text {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.5;
}

.contact-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  border-radius: 16rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-size: 28rpx;
}

/* 联系说明 */
.info-section {
  margin-bottom: 32rpx;
}

.info-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.info-header {
  margin-bottom: 24rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.info-icon {
  font-size: 24rpx;
  color: #10b981;
  flex-shrink: 0;
}

.info-text {
  font-size: 26rpx;
  color: #475569;
}

/* 其他联系方式 */
.other-section {
  margin-bottom: 32rpx;
}

.other-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.other-header {
  margin-bottom: 24rpx;
}

.other-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.other-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.other-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.other-item:last-child {
  border-bottom: none;
}

.other-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.other-info {
  flex: 1;
}

.other-label {
  font-size: 22rpx;
  color: #64748b;
  display: block;
  margin-bottom: 4rpx;
}

.other-value {
  font-size: 26rpx;
  color: #1e293b;
  font-weight: 500;
}

.copy-btn {
  padding: 12rpx 24rpx;
  background: #f1f5f9;
  color: #64748b;
  border-radius: 12rpx;
  border: none;
  font-size: 24rpx;
  font-weight: 500;
}
