.tab-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 100rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #e2e8f0;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: 12rpx;
  color: #64748b;
  background-color: #f1f5f9;
}

.tab-item.active .tab-icon {
  color: #6366f1;
  background-color: #e0e7ff;
}

.tab-text {
  font-size: 24rpx;
  color: #64748b;
}

.voice-container {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding-top: -20rpx;
}

.voice-button {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 6rpx 18rpx rgba(99, 102, 241, 0.4);
  animation: pulse 2s infinite;
  margin-top: -30rpx;
  border: 8rpx solid white;
}

.voice-icon {
  font-size: 48rpx;
  color: white;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.7);
  }
  70% {
    box-shadow: 0 0 0 20rpx rgba(99, 102, 241, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(99, 102, 241, 0);
  }
}

.tab-item.active .tab-text {
  color: #6366f1;
}